# ============================================================================
# AWARE / Polybot configuration
# ============================================================================
# Copy to .env in this directory (the repo root). The Makefile and the
# production compose files both read it from here.
#
# NEVER commit .env.
# ============================================================================


# ----------------------------------------------------------------------------
# Deployment — only used by `make deploy` and `make ssh` from your machine
# ----------------------------------------------------------------------------
SERVER_USER=
SERVER_IP=
PROJECT_PATH=/opt/aware


# ----------------------------------------------------------------------------
# Public access (Caddy runs in a container and handles TLS by itself)
# ----------------------------------------------------------------------------
# Point this domain's A record at the server before deploying. Caddy requests
# and renews the certificate on its own; there is nothing to install or
# schedule on the host.
AWARE_DOMAIN=

# Dashboard login. Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password
# Keep the SINGLE QUOTES: without them compose treats the $ segments of the
# bcrypt hash as variables and mangles it.
AWARE_USER=admin
AWARE_PASSWORD_HASH=''


# ----------------------------------------------------------------------------
# Host ports (production)
# ----------------------------------------------------------------------------
# Every service binds to 127.0.0.1 and is reached by Caddy over the compose
# network, so these are only for debugging from the server itself. Nothing here
# is public: Caddy owns 80 and 443. Change them only on a port clash.
WEB_PORT=3000
API_PORT=8000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
EXECUTOR_PORT=8080
STRATEGY_PORT=8081
INGESTOR_PORT=8083


# ----------------------------------------------------------------------------
# Trading mode
# ----------------------------------------------------------------------------
# PAPER simulates fills against the live order book. LIVE trades real money.
HFT_MODE=PAPER


# ----------------------------------------------------------------------------
# Secrets required by the production stack
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=


# ----------------------------------------------------------------------------
# Polymarket credentials
# ----------------------------------------------------------------------------
# Only needed for LIVE. Leave them EMPTY for PAPER — not a placeholder string:
# the executor validates the private key on startup and refuses to boot with
# anything that is not empty or 0x + 64 hex chars:
#   IllegalArgumentException: hft.polymarket.auth.private-key must be 0x + 64 hex chars
#
# Note the name is POLYMARKET_PASSPHRASE, not POLYMARKET_API_PASSPHRASE —
# that is what the compose file looks for.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=

# Wallet private key without the 0x prefix, when going live.
# Signature type: 0 = EOA, 1 = Poly Proxy, 2 = Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_NONCE=0


# ----------------------------------------------------------------------------
# Local development only
# ----------------------------------------------------------------------------
# The production compose file sets these per service; these values are for
# running the Python jobs or the Java services straight from your machine.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DATABASE=polybot
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ANALYTICS_DB_URL=jdbc:clickhouse://localhost:8123/polybot
POLYGON_RPC_URL=https://polygon-rpc.com

# Polymarket username to analyse in the research scripts.
POLYMARKET_TARGET_USER=

# Optional alert destination.
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Alert delivery (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Where the insider and discovery alerts are sent. Configured here rather than
# from the dashboard, which is read-only: leave a channel blank and it is off.
# The dashboard still lists every alert whether or not any of these are set.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# Floor on what gets delivered: LOW, MEDIUM, HIGH or CRITICAL. The detector
# labels LOW as "interesting but not actionable", so HIGH is a sane starting
# point for anything that pings a phone.
ALERT_MIN_SEVERITY=HIGH
# How long the same alert stays suppressed after being sent once.
ALERT_DEDUP_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# Operational alerting
# ─────────────────────────────────────────────────────────────────────────────
# Fires when a pipeline job fails or the engine stops trading, over the same
# channels as above. How long a problem stays quiet after being reported, so a
# persistent failure does not become an hourly message:
OPS_ALERT_REPEAT_HOURS=6
# How long without an order or a fill before the engine counts as stalled:
OPS_ALERT_STALL_MINUTES=60
# Jobs whose failure is known and not actionable. Both of these fail because
# the ml/models package is absent from the repository. Remove a name the day
# its cause is fixed.
OPS_ALERT_IGNORE_JOBS=ml_enrichment,drift_monitoring
