# ============================================================================
# AWARE / Polybot configuration
# ============================================================================
# Copy to .env in this directory (the repo root). The Makefile and the
# production compose files both read it from here.
#
# NEVER commit .env.
# ============================================================================


# ----------------------------------------------------------------------------
# Deployment — only used by `make deploy` and `make ssh` from your machine
# ----------------------------------------------------------------------------
SERVER_USER=
SERVER_IP=
PROJECT_PATH=/opt/aware

# The public domain is deliberately not here. It lives in the server's
# Caddyfile: the dashboard serves the API on its own origin and never needs to
# know its own hostname.


# ----------------------------------------------------------------------------
# Host ports (production)
# ----------------------------------------------------------------------------
# Every service binds to 127.0.0.1, so these only need to avoid clashing with
# whatever else runs on the box. Only WEB_PORT is reached from outside, through
# the reverse proxy; point Caddy at the value you set here.
WEB_PORT=3000
API_PORT=8000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
EXECUTOR_PORT=8080
STRATEGY_PORT=8081
INGESTOR_PORT=8083


# ----------------------------------------------------------------------------
# Trading mode
# ----------------------------------------------------------------------------
# PAPER simulates fills against the live order book. LIVE trades real money.
HFT_MODE=PAPER


# ----------------------------------------------------------------------------
# Secrets required by the production stack
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=


# ----------------------------------------------------------------------------
# Polymarket credentials
# ----------------------------------------------------------------------------
# Only needed for LIVE. In PAPER nothing reads them, but the production compose
# file expects the names to exist, so leave the placeholders in place.
#
# Note the name is POLYMARKET_PASSPHRASE, not POLYMARKET_API_PASSPHRASE —
# that is what the compose file looks for.
POLYMARKET_API_KEY=unused-in-paper
POLYMARKET_API_SECRET=unused-in-paper
POLYMARKET_PASSPHRASE=unused-in-paper
POLYMARKET_PRIVATE_KEY=unused-in-paper

# Wallet private key without the 0x prefix, when going live.
# Signature type: 0 = EOA, 1 = Poly Proxy, 2 = Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_NONCE=0


# ----------------------------------------------------------------------------
# Local development only
# ----------------------------------------------------------------------------
# The production compose file sets these per service; these values are for
# running the Python jobs or the Java services straight from your machine.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DATABASE=polybot
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ANALYTICS_DB_URL=jdbc:clickhouse://localhost:8123/polybot
POLYGON_RPC_URL=https://polygon-rpc.com

# Polymarket username to analyse in the research scripts.
POLYMARKET_TARGET_USER=

# Optional alert destination.
SLACK_WEBHOOK_URL=
