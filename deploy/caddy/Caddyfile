# ═══════════════════════════════════════════════════════════════════════════
# AWARE — Caddy site config
# ═══════════════════════════════════════════════════════════════════════════
# Reference snippet to copy into /etc/caddy/Caddyfile on the host. Caddy runs
# as a normal system service; nothing here is containerised.
#
# Only the dashboard's port is proxied. It rewrites /api/* to the API over the
# compose network by itself (see next.config.js), so the API needs no route of
# its own. Everything else binds to 127.0.0.1 and stays unreachable.
#
# Setup:
#   caddy hash-password        # paste the bcrypt hash below
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
# ═══════════════════════════════════════════════════════════════════════════

aware.example.com {
	encode gzip

	# Covers the dashboard and, through it, the API. Generate the hash with
	# `caddy hash-password` — never a plaintext password here.
	# On Caddy older than 2.8 the directive is `basicauth`.
	basic_auth {
		your_user $2a$14$replace.this.with.the.generated.hash
	}

	reverse_proxy localhost:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/aware.log
		format json
	}
}

# ═══════════════════════════════════════════════════════════════════════════
# Deliberately not routed
# ═══════════════════════════════════════════════════════════════════════════
# Grafana (127.0.0.1:3001) and Prometheus (127.0.0.1:9090) are reachable over
# an SSH tunnel instead:  ssh -L 3001:127.0.0.1:3001 user@server
# Every route published here is another way in.
