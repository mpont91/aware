# ═══════════════════════════════════════════════════════════════════════════
# AWARE — Caddy config
# ═══════════════════════════════════════════════════════════════════════════
# Mounted into the caddy container by docker-compose.caddy.yaml. Values come
# from .env in the repo root, so this file needs no editing to deploy.
#
# Caddy obtains and renews the certificate itself on first request. Nothing to
# run beforehand and nothing to schedule afterwards.
#
# Only the dashboard is proxied: it rewrites /api/* to the API over the compose
# network by itself (next.config.js), so the API needs no route of its own and
# stays unreachable from outside.
# ═══════════════════════════════════════════════════════════════════════════

{$AWARE_DOMAIN} {
	encode gzip

	# Covers the dashboard and, through it, the API. Same origin, so the
	# browser sends the credentials to both and there is no CORS to configure.
	basic_auth {
		{$AWARE_USER} {$AWARE_PASSWORD_HASH}
	}

	# Service name on the compose network, not localhost: Caddy runs in its
	# own container.
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# ═══════════════════════════════════════════════════════════════════════════
# Deliberately not routed
# ═══════════════════════════════════════════════════════════════════════════
# Grafana and Prometheus. They stay on 127.0.0.1 and are reachable over an SSH
# tunnel:  ssh -L 3001:127.0.0.1:3001 user@server
# Every route published here is another way in.
